{
  "name": "@mehul0810/agent-skills",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "harness": "agent-harness validate --config agent-harness.config.json",
    "context:development": "agent-harness plan-context --config agent-harness.config.json --route \"Plugin architecture\"",
    "context:marketing": "agent-harness plan-context --config agent-harness.config.json --route \"Content research\"",
    "context:business": "agent-harness plan-context --config agent-harness.config.json --route \"Product value decision\"",
    "run-record:example": "agent-harness validate-run --file skill-evals/run-record.example.json",
    "run-record:behavior": "node scripts/validate-behavior-run-records.mjs",
    "validate:behavior-evidence": "node scripts/behavior-evidence-audit.mjs --self-test && node scripts/behavior-evidence-audit.mjs",
    "validate:contracts": "node scripts/contract-integrity-audit.mjs && node scripts/source-freshness-audit.mjs",
    "validate:graph": "node wp-expert/scripts/validate-engineering-graph.mjs --self-test",
    "validate:visual": "node wp-expert/scripts/validate-visual-proof.mjs --self-test && node wp-expert/scripts/validate-asset-production.mjs --self-test && node wp-expert/scripts/validate-spatial-proof.mjs --self-test && node wp-expert/scripts/capture-spatial-measurements.mjs --self-test && bash scripts/visual-wordpress-behavior-audit.sh",
    "validate:quality": "node wp-quality-reviewer/scripts/validate-review-report.mjs --self-test && bash scripts/quality-reviewer-behavior-audit.sh",
    "validate:video": "node product-video-producer/scripts/validate-video-manifest.mjs --self-test && bash scripts/video-production-behavior-audit.sh",
    "test": "node scripts/validate-all.mjs"
  },
  "devDependencies": {
    "@mehul0810/agent-harness": "https://github.com/mehul0810/agent-harness/archive/fe1fe276ca5027b4407ef34334fd41317027c471.tar.gz"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
