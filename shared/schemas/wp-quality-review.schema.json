{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mehul0810/agent-skills/shared/schemas/wp-quality-review.schema.json",
  "title": "WordPress Quality Review",
  "$defs": {
    "accessibilityAudit": {
      "type": "object",
      "required": ["standard", "evaluatedOn", "technologies", "criteria", "checks"],
      "additionalProperties": false,
      "properties": {
        "standard": { "const": "WCAG 2.2 AA" },
        "evaluatedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "technologies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "pattern": "\\S" } },
        "criteria": {
          "description": "All 55 A/AA criteria in the W3C WCAG 2.2 Recommendation, checked 2026-08-31; excludes obsolete 4.1.1 and AAA.",
          "type": "object",
          "minProperties": 55,
          "maxProperties": 55,
          "propertyNames": {
            "enum": [
              "1.1.1", "1.2.1", "1.2.2", "1.2.3", "1.2.4", "1.2.5",
              "1.3.1", "1.3.2", "1.3.3", "1.3.4", "1.3.5",
              "1.4.1", "1.4.2", "1.4.3", "1.4.4", "1.4.5", "1.4.10", "1.4.11", "1.4.12", "1.4.13",
              "2.1.1", "2.1.2", "2.1.4", "2.2.1", "2.2.2", "2.3.1",
              "2.4.1", "2.4.2", "2.4.3", "2.4.4", "2.4.5", "2.4.6", "2.4.7", "2.4.11",
              "2.5.1", "2.5.2", "2.5.3", "2.5.4", "2.5.7", "2.5.8",
              "3.1.1", "3.1.2", "3.2.1", "3.2.2", "3.2.3", "3.2.4", "3.2.6",
              "3.3.1", "3.3.2", "3.3.3", "3.3.4", "3.3.7", "3.3.8", "4.1.2", "4.1.3"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "required": ["status", "rationale", "checks"],
            "additionalProperties": false,
            "properties": {
              "status": { "enum": ["pass", "fail", "blocked", "not_applicable"] },
              "rationale": { "type": "string", "minLength": 12, "pattern": "\\S" },
              "checks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "checks": {
          "type": "object",
          "required": ["fullPages", "completeProcesses", "accessibilitySupport", "nonInterference", "keyboard", "assistiveTechnology", "automatedScan"],
          "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
          "properties": {
            "fullPages": { "$ref": "#/$defs/accessibilityManualCheck" },
            "completeProcesses": { "$ref": "#/$defs/accessibilityManualCheck" },
            "accessibilitySupport": { "$ref": "#/$defs/accessibilityManualCheck" },
            "nonInterference": { "$ref": "#/$defs/accessibilityManualCheck" },
            "keyboard": { "$ref": "#/$defs/accessibilityManualCheck" },
            "assistiveTechnology": { "$ref": "#/$defs/accessibilityManualCheck" },
            "automatedScan": { "$ref": "#/$defs/accessibilityAutomatedCheck" }
          },
          "additionalProperties": { "$ref": "#/$defs/validationReceipt" }
        }
      }
    },
    "accessibilityManualCheck": {
      "allOf": [
        { "$ref": "#/$defs/validationReceipt" },
        { "required": ["artifact"], "properties": { "kind": { "const": "manual" } } }
      ]
    },
    "accessibilityAutomatedCheck": {
      "allOf": [
        { "$ref": "#/$defs/validationReceipt" },
        { "required": ["artifact", "artifactSha256"], "properties": { "kind": { "const": "static" } } }
      ]
    },
    "aaaAdvisoryCriteria": {
      "description": "Optional AAA-only advice outside the AA conformance target, never a waiver of an A/AA defect.",
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["1.2.6", "1.2.7", "1.2.8", "1.2.9", "1.3.6", "1.4.6", "1.4.7", "1.4.8", "1.4.9", "2.1.3", "2.2.3", "2.2.4", "2.2.5", "2.2.6", "2.3.2", "2.3.3", "2.4.8", "2.4.9", "2.4.10", "2.4.12", "2.4.13", "2.5.5", "2.5.6", "3.1.3", "3.1.4", "3.1.5", "3.1.6", "3.2.5", "3.3.5", "3.3.6", "3.3.9"] }
    },
    "evidenceReceipt": {
      "type": "object",
      "required": ["kind", "pointer", "observation"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["code", "git", "github", "runtime", "test", "browser", "profile", "dependency", "document", "package", "public", "owner"] },
        "pointer": { "type": "string", "minLength": 5 },
        "observation": { "type": "string", "minLength": 12 },
        "environment": { "type": "string", "minLength": 8 },
        "identity": { "$ref": "#/$defs/candidateIdentity" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["runtime", "browser", "profile"] } }, "required": ["kind"] },
          "then": { "required": ["environment"] }
        },
        {
          "if": { "properties": { "kind": { "const": "package" } }, "required": ["kind"] },
          "then": { "required": ["identity"] }
        }
      ]
    },
    "candidateIdentity": {
      "type": "object",
      "required": ["commitSha"],
      "additionalProperties": false,
      "properties": {
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "validationReceipt": {
      "type": "object",
      "required": ["kind", "check", "expected", "observed", "result"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["static", "test", "runtime", "browser", "manual", "profile", "package"] },
        "check": { "type": "string", "minLength": 8 },
        "expected": { "type": "string", "minLength": 12 },
        "observed": { "type": "string", "minLength": 12 },
        "expectedState": { "enum": ["allow", "deny", "reject", "sanitize", "preserve", "within_budget", "accessible", "success", "failure", "blocked"] },
        "observedState": { "enum": ["allow", "deny", "reject", "sanitize", "preserve", "within_budget", "accessible", "success", "failure", "blocked"] },
        "result": { "enum": ["pass", "fail", "blocked"] },
        "environment": { "type": "string", "minLength": 8 },
        "artifact": { "type": "string", "minLength": 5 },
        "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "identity": { "$ref": "#/$defs/candidateIdentity" },
        "claim": { "enum": ["security_negative", "performance_comparable", "modularity_behavior", "accessibility_manual", "accessibility_automated", "contract_compatibility", "migration_step"] },
        "browser": { "type": "string", "minLength": 3 },
        "assistiveTechnology": { "type": "string", "minLength": 3 },
        "performanceMeasurement": { "$ref": "#/$defs/performanceMeasurement" },
        "securityCases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/securityCase" } },
        "contractCases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contractCase" } },
        "performanceChecks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/performanceCheck" } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["runtime", "browser", "manual", "profile"] } }, "required": ["kind"] },
          "then": { "required": ["environment"] }
        },
        {
          "if": { "properties": { "claim": { "const": "security_negative" } }, "required": ["claim"] },
          "then": { "required": ["securityCases", "expectedState", "observedState"], "properties": { "expectedState": { "enum": ["deny", "reject", "sanitize"] }, "observedState": { "enum": ["deny", "reject", "sanitize"] } } }
        },
        {
          "if": { "properties": { "claim": { "enum": ["modularity_behavior", "contract_compatibility"] } }, "required": ["claim"] },
          "then": { "required": ["contractCases", "expectedState", "observedState"], "properties": { "expectedState": { "const": "preserve" }, "observedState": { "const": "preserve" } } }
        },
        {
          "if": { "properties": { "claim": { "const": "performance_comparable" } }, "required": ["claim"] },
          "then": { "required": ["performanceMeasurement", "expectedState", "observedState"], "properties": { "expectedState": { "const": "within_budget" }, "observedState": { "const": "within_budget" } } }
        },
        {
          "if": { "properties": { "claim": { "const": "accessibility_manual" } }, "required": ["claim"] },
          "then": { "required": ["browser", "assistiveTechnology", "expectedState", "observedState"], "properties": { "expectedState": { "const": "accessible" }, "observedState": { "const": "accessible" } } }
        },
        {
          "if": { "properties": { "claim": { "const": "accessibility_automated" } }, "required": ["claim"] },
          "then": { "required": ["expectedState", "observedState", "artifactSha256"], "properties": { "expectedState": { "const": "accessible" }, "observedState": { "const": "accessible" } } }
        }
      ]
    },
    "domainDisposition": {
      "type": "object",
      "required": ["disposition"],
      "additionalProperties": false,
      "properties": {
        "disposition": { "enum": ["pass", "fail", "partial", "not_applicable"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceReceipt" } },
        "validation": { "type": "array", "items": { "$ref": "#/$defs/validationReceipt" } },
        "authorizationMatrix": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/authorizationCheck" } },
        "resourceBudget": { "$ref": "#/$defs/resourceBudget" },
        "capacityEnvelope": { "$ref": "#/$defs/capacityEnvelope" },
        "reason": { "type": "string", "minLength": 12 }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "not_applicable" } }, "required": ["disposition"] },
          "then": { "required": ["reason"], "properties": { "evidence": { "maxItems": 0 }, "validation": { "maxItems": 0 } } },
          "else": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } }
        }
      ]
    },
    "performanceMeasurement": {
      "type": "object",
      "required": ["metric", "unit", "direction", "before", "after", "budget", "conditions"],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string", "minLength": 6 },
        "unit": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["lower_is_better", "higher_is_better"] },
        "before": { "type": "number" },
        "after": { "type": "number" },
        "budget": { "type": "number" },
        "conditions": { "type": "string", "minLength": 12 },
        "baselineConditions": { "$ref": "#/$defs/performanceConditions" },
        "candidateConditions": { "$ref": "#/$defs/performanceConditions" },
        "sampleSize": { "type": "integer", "minimum": 1 },
        "distribution": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "p50": { "type": "number", "minimum": 0 },
            "p75": { "type": "number", "minimum": 0 },
            "p95": { "type": "number", "minimum": 0 },
            "p99": { "type": "number", "minimum": 0 }
          }
        },
        "variance": { "type": "number", "minimum": 0 },
        "errorRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "cacheState": { "enum": ["cold", "warm", "mixed", "not_applicable"] },
        "fieldOrLab": { "enum": ["field", "lab", "both"] },
        "runCount": { "type": "integer", "minimum": 1 },
        "provenance": { "type": "string", "minLength": 8 },
        "limitations": { "type": "string", "minLength": 8 }
      }
    },
    "performanceConditions": {
      "type": "object",
      "required": ["runtime", "dataset", "cacheState", "concurrency"],
      "additionalProperties": false,
      "properties": {
        "runtime": { "type": "string", "minLength": 4 },
        "dataset": { "type": "string", "minLength": 4 },
        "cacheState": { "type": "string", "minLength": 4 },
        "concurrency": { "type": "integer", "minimum": 1 }
      }
    },
    "securityCase": {
      "type": "object",
      "required": ["actorClass", "actor", "input", "resource", "boundary", "expected", "observed", "result"],
      "additionalProperties": false,
      "properties": {
        "actorClass": { "enum": ["anonymous", "low_privilege", "wrong_object", "external_service", "malformed_input"] },
        "actor": { "type": "string", "minLength": 6 },
        "input": { "type": "string", "minLength": 6 },
        "resource": { "type": "string", "minLength": 6 },
        "boundary": { "enum": ["authentication", "capability", "nonce", "ownership", "validation", "escaping", "rate_limit", "secret_boundary", "tenant_isolation"] },
        "expected": { "enum": ["deny", "reject", "sanitize"] },
        "observed": { "enum": ["deny", "reject", "sanitize"] },
        "result": { "const": "pass" }
      }
    },
    "contractCase": {
      "type": "object",
      "required": ["surface", "entryPoint", "consumer", "contract", "before", "after", "result"],
      "additionalProperties": false,
      "properties": {
        "surface": { "enum": ["public_hook", "rest_route", "block_markup", "cli_command", "stored_data", "user_journey"] },
        "entryPoint": { "type": "string", "minLength": 5 },
        "consumer": { "enum": ["visitor", "administrator", "editor", "integrator", "cli_user"] },
        "contract": { "type": "string", "minLength": 6 },
        "before": { "type": "string", "minLength": 6 },
        "after": { "type": "string", "minLength": 6 },
        "result": { "enum": ["preserved", "versioned"] }
      }
    },
    "performanceCheck": {
      "type": "object",
      "required": ["kind", "expected", "observed", "result"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["tail", "overload", "recovery", "cache", "capacity"] },
        "expected": { "type": "string", "minLength": 12 },
        "observed": { "type": "string", "minLength": 12 },
        "result": { "const": "pass" }
      }
    },
    "authorizationCheck": {
      "type": "object",
      "required": ["actor", "action", "resource", "expected", "observed", "evidence"],
      "additionalProperties": false,
      "properties": {
        "actor": { "type": "string", "minLength": 3 },
        "action": { "type": "string", "minLength": 3 },
        "resource": { "type": "string", "minLength": 3 },
        "expected": { "enum": ["allow", "deny"] },
        "observed": { "enum": ["allow", "deny"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceReceipt" } }
      }
    },
    "resourceBudget": {
      "type": "object",
      "required": ["scope", "limits", "failureBehavior", "evidence"],
      "additionalProperties": false,
      "properties": {
        "scope": { "type": "string", "minLength": 8 },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "value", "unit"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 3 },
              "value": { "type": "number", "minimum": 0 },
              "unit": { "type": "string", "minLength": 1 }
            }
          }
        },
        "failureBehavior": { "type": "string", "minLength": 12 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceReceipt" } }
      }
    },
    "capacityEnvelope": {
      "type": "object",
      "required": ["workload", "headroomPercent", "saturation", "fairness", "queue", "storage", "failureBehavior", "evidence"],
      "additionalProperties": false,
      "properties": {
        "workload": {
          "type": "object", "required": ["description", "concurrency", "dataVolume", "durationSeconds"], "additionalProperties": false,
          "properties": {
            "description": { "type": "string", "minLength": 12 },
            "concurrency": { "type": "number", "exclusiveMinimum": 0 },
            "dataVolume": { "type": "number", "exclusiveMinimum": 0 },
            "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "headroomPercent": { "type": "number", "exclusiveMinimum": 0 },
        "saturation": {
          "type": "object", "required": ["metric", "observed", "budget", "direction"], "additionalProperties": false,
          "properties": {
            "metric": { "type": "string", "minLength": 4 },
            "observed": { "type": "number" },
            "budget": { "type": "number" },
            "direction": { "enum": ["lower_is_better", "higher_is_better"] }
          }
        },
        "fairness": {
          "type": "object", "required": ["scope", "limit", "unit"], "additionalProperties": false,
          "properties": { "scope": { "type": "string", "minLength": 4 }, "limit": { "type": "number", "exclusiveMinimum": 0 }, "unit": { "type": "string", "minLength": 1 } }
        },
        "queue": {
          "type": "object", "required": ["arrivalRate", "serviceRate", "maxBacklog", "observedBacklog", "drainSeconds", "drainBudgetSeconds"], "additionalProperties": false,
          "properties": {
            "arrivalRate": { "type": "number", "minimum": 0 }, "serviceRate": { "type": "number", "minimum": 0 },
            "maxBacklog": { "type": "number", "minimum": 0 }, "observedBacklog": { "type": "number", "minimum": 0 },
            "drainSeconds": { "type": "number", "minimum": 0 }, "drainBudgetSeconds": { "type": "number", "minimum": 0 }
          }
        },
        "storage": {
          "type": "object", "required": ["currentBytes", "projectedBytes", "restoreSeconds", "restoreBudgetSeconds"], "additionalProperties": false,
          "properties": {
            "currentBytes": { "type": "number", "minimum": 0 }, "projectedBytes": { "type": "number", "minimum": 0 },
            "restoreSeconds": { "type": "number", "minimum": 0 }, "restoreBudgetSeconds": { "type": "number", "minimum": 0 }
          }
        },
        "failureBehavior": { "type": "string", "minLength": 12 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceReceipt" } }
      }
    },
    "independentReview": {
      "type": "object",
      "required": ["kind", "runId", "reviewedCommitSha", "result", "evidence"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "fresh_source_aware" },
        "runId": { "type": "string", "minLength": 5 },
        "reviewedCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "result": { "const": "pass" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceReceipt" } }
      }
    },
    "migrationPlan": {
      "type": "object",
      "required": ["strategy", "expandCheck", "backfillCheck", "idempotencyCheck", "rollbackCheck", "contractStatus"],
      "additionalProperties": false,
      "properties": {
        "strategy": { "const": "expand_migrate_contract" },
        "expandCheck": { "$ref": "#/$defs/validationReceipt" },
        "backfillCheck": { "$ref": "#/$defs/validationReceipt" },
        "idempotencyCheck": { "$ref": "#/$defs/validationReceipt" },
        "rollbackCheck": { "$ref": "#/$defs/validationReceipt" },
        "contractStatus": { "enum": ["deferred", "owner_approved"] },
        "cleanupIssue": { "type": "string", "minLength": 5 },
        "ownerApproval": { "$ref": "#/$defs/evidenceReceipt" }
      }
    },
    "modularityRatchet": {
      "type": "object",
      "required": ["metric", "baseline", "after", "budget", "posture"],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string", "minLength": 4 },
        "baseline": { "type": "number", "minimum": 0 },
        "after": { "type": "number", "minimum": 0 },
        "budget": { "type": "number", "minimum": 0 },
        "posture": { "enum": ["reduced", "no_growth", "exception"] },
        "owner": { "type": "string", "minLength": 8 },
        "issue": { "type": "string", "minLength": 5 },
        "rationale": { "type": "string", "minLength": 8 }
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "area", "severity", "status", "evidence", "impact", "remediation", "validation"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "area": { "enum": ["security", "performance", "modularity", "accessibility"] },
        "severity": { "enum": ["P0", "P1", "P2", "P3"] },
        "status": { "enum": ["open", "fixed", "accepted"] },
        "riskFlags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["release_critical", "migration", "public_contract", "authorization_boundary", "resource_abuse", "legacy_debt"] }
        },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceReceipt" } },
        "impact": { "type": "string", "minLength": 12 },
        "remediation": { "type": "string", "minLength": 12 },
        "validation": { "type": "array", "items": { "$ref": "#/$defs/validationReceipt" } },
        "performanceMeasurement": { "$ref": "#/$defs/performanceMeasurement" },
        "authorizationMatrix": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/authorizationCheck" }
        },
        "resourceBudget": { "$ref": "#/$defs/resourceBudget" },
        "negativeTests": { "type": "array", "items": { "$ref": "#/$defs/validationReceipt" } },
        "behaviorChecks": { "type": "array", "items": { "$ref": "#/$defs/validationReceipt" } },
        "contractChecks": { "type": "array", "items": { "$ref": "#/$defs/validationReceipt" } },
        "migrationPlan": { "$ref": "#/$defs/migrationPlan" },
        "modularityRatchet": { "$ref": "#/$defs/modularityRatchet" },
        "manualChecks": { "type": "array", "items": { "$ref": "#/$defs/validationReceipt" } },
        "aaaAdvisoryCriteria": { "$ref": "#/$defs/aaaAdvisoryCriteria" },
        "independentReview": { "$ref": "#/$defs/independentReview" },
        "riskAcceptance": { "$ref": "#/$defs/evidenceReceipt" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "fixed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "validation": {
                "minItems": 1,
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/validationReceipt" },
                    { "properties": { "result": { "const": "pass" } } }
                  ]
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "fixed" }, "area": { "const": "security" } }, "required": ["status", "area"] },
          "then": { "required": ["negativeTests"], "properties": { "negativeTests": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "fixed" }, "area": { "const": "performance" } }, "required": ["status", "area"] },
          "then": { "required": ["performanceMeasurement"] }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "fixed" },
              "area": { "const": "security" },
              "riskFlags": { "contains": { "const": "authorization_boundary" } }
            },
            "required": ["status", "area", "riskFlags"]
          },
          "then": { "required": ["authorizationMatrix"] }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "fixed" },
              "riskFlags": { "contains": { "const": "resource_abuse" } }
            },
            "required": ["status", "riskFlags"]
          },
          "then": { "required": ["resourceBudget"] }
        },
        {
          "if": { "properties": { "status": { "const": "fixed" }, "area": { "const": "modularity" } }, "required": ["status", "area"] },
          "then": { "required": ["behaviorChecks"], "properties": { "behaviorChecks": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "fixed" }, "riskFlags": { "contains": { "const": "public_contract" } } }, "required": ["status", "riskFlags"] },
          "then": { "required": ["contractChecks"], "properties": { "contractChecks": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "riskFlags": { "contains": { "const": "migration" } } }, "required": ["riskFlags"] },
          "then": { "required": ["migrationPlan"] }
        },
        {
          "if": { "properties": { "riskFlags": { "contains": { "const": "legacy_debt" } } }, "required": ["riskFlags"] },
          "then": { "required": ["modularityRatchet"] }
        },
        {
          "if": { "properties": { "status": { "const": "fixed" }, "area": { "const": "accessibility" } }, "required": ["status", "area"] },
          "then": { "required": ["manualChecks"], "properties": { "manualChecks": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "accepted" } }, "required": ["status"] },
          "then": {
            "required": ["riskAcceptance"],
            "properties": {
              "riskAcceptance": {
                "allOf": [
                  { "$ref": "#/$defs/evidenceReceipt" },
                  { "properties": { "kind": { "const": "owner" } } }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "fixed" },
              "severity": { "enum": ["P0", "P1"] }
            },
            "required": ["status", "severity"]
          },
          "then": { "required": ["independentReview"] }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "fixed" },
              "riskFlags": {
                "contains": {
                  "enum": ["release_critical", "migration", "public_contract"]
                }
              }
            },
            "required": ["status", "riskFlags"]
          },
          "then": { "required": ["independentReview"] }
        }
      ]
    }
  },
  "type": "object",
  "required": ["schemaVersion", "mode", "targetIdentity", "scope", "qualityTarget", "domains", "findings", "proofGaps", "conclusion"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "mode": { "enum": ["security", "performance", "modularity", "accessibility", "multi"] },
    "targetIdentity": {
      "type": "object",
      "required": ["kind", "repository", "commitSha"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["commit", "package"] },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "baseCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "artifact": {
          "type": "object",
          "required": ["path", "sha256"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 5 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "package" } }, "required": ["kind"] },
          "then": { "required": ["artifact"] }
        }
      ]
    },
    "scope": {
      "type": "object",
      "required": ["targets", "exclusions"],
      "additionalProperties": false,
      "properties": {
        "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "qualityTarget": { "type": "string", "minLength": 8 },
    "assuranceProfile": {
      "type": "object",
      "required": ["level", "risks"],
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["standard", "elevated"] },
        "risks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["high_traffic", "sensitive_data", "custom_storage", "migration", "public_api", "async_queue", "external_webhook", "multi_tenant", "legacy_debt"] }
        }
      }
    },
    "accessibilityClaim": { "enum": ["scoped_review", "wcag22_aa_conformance"] },
    "accessibilityAudit": { "$ref": "#/$defs/accessibilityAudit" },
    "domains": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "security": { "$ref": "#/$defs/domainDisposition" },
        "performance": { "$ref": "#/$defs/domainDisposition" },
        "modularity": { "$ref": "#/$defs/domainDisposition" },
        "accessibility": { "$ref": "#/$defs/domainDisposition" }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "proofGaps": { "type": "array", "items": { "type": "string", "minLength": 12 } },
    "conclusion": { "enum": ["pass", "fail", "partial", "blocked"] }
  },
  "allOf": [
    {
      "if": {
        "required": ["domains"],
        "properties": {
          "domains": {
            "required": ["accessibility"],
            "properties": {
              "accessibility": { "properties": { "disposition": { "not": { "const": "not_applicable" } } } }
            }
          }
        }
      },
      "then": { "required": ["accessibilityClaim"] }
    },
    {
      "if": { "required": ["accessibilityClaim"], "properties": { "accessibilityClaim": { "const": "wcag22_aa_conformance" } } },
      "then": { "required": ["accessibilityAudit"] },
      "else": { "not": { "required": ["accessibilityAudit"] } }
    },
    {
      "if": { "properties": { "mode": { "const": "multi" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "domains": {
            "required": ["security", "performance", "modularity", "accessibility"]
          }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "security" } }, "required": ["mode"] },
      "then": { "properties": { "domains": { "required": ["security"], "maxProperties": 1 } } }
    },
    {
      "if": { "properties": { "mode": { "const": "performance" } }, "required": ["mode"] },
      "then": { "properties": { "domains": { "required": ["performance"], "maxProperties": 1 } } }
    },
    {
      "if": { "properties": { "mode": { "const": "modularity" } }, "required": ["mode"] },
      "then": { "properties": { "domains": { "required": ["modularity"], "maxProperties": 1 } } }
    },
    {
      "if": { "properties": { "mode": { "const": "accessibility" } }, "required": ["mode"] },
      "then": { "properties": { "domains": { "required": ["accessibility"], "maxProperties": 1 } } }
    }
  ]
}
