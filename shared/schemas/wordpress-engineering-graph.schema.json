{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mehul0810/agent-skills/shared/schemas/wordpress-engineering-graph.schema.json",
  "title": "WordPress Engineering Graph",
  "type": "object",
  "required": ["schemaVersion", "task", "nodes"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "assuranceLevel": {
      "enum": ["baseline", "elevated"]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "owner", "state", "critical", "dependsOn", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "type": {
            "enum": [
              "intent",
              "owner",
              "artifact",
              "runtime",
              "observation",
              "correction",
              "proof",
              "outcome",
              "learning"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": ["verified", "provisional", "unknown", "failed", "not_applicable"]
          },
          "critical": {
            "type": "boolean"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "notApplicableReason": {
            "type": "string"
          },
          "proofKind": {
            "enum": ["verification", "regression"]
          },
          "promotion": {
            "type": "object",
            "required": ["destination", "status", "reviewer"],
            "properties": {
              "destination": {
                "type": "object",
                "required": ["kind", "pointer"],
                "properties": {
                  "kind": {
                    "enum": ["repo_doc", "adr", "issue", "skill", "automation"]
                  },
                  "pointer": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "status": {
                "const": "verified"
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "pointer"],
              "properties": {
                "kind": {
                  "enum": ["repo", "git", "github", "runtime", "test", "browser", "editor", "package", "public", "owner"]
                },
                "pointer": {
                  "type": "string",
                  "minLength": 1
                },
                "identity": {
                  "type": "object",
                  "minProperties": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": { "const": "learning" }
              },
              "required": ["type"]
            },
            "then": {
              "required": ["promotion"],
              "properties": {
                "state": {
                  "const": "verified"
                },
                "dependsOn": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": { "const": "learning" },
                "state": { "const": "verified" }
              },
              "required": ["type", "state"]
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "required": ["promotion"]
            },
            "then": {
              "properties": {
                "type": {
                  "const": "learning"
                }
              }
            }
          },
          {
            "if": {
              "required": ["proofKind"]
            },
            "then": {
              "properties": {
                "type": {
                  "const": "proof"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": { "const": "observation" },
                "state": { "const": "failed" }
              },
              "required": ["type", "state"]
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": { "const": "correction" },
                "state": { "const": "verified" }
              },
              "required": ["type", "state"]
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "proofKind": { "const": "regression" }
              },
              "required": ["proofKind"]
            },
            "then": {
              "properties": {
                "type": {
                  "const": "proof"
                },
                "state": {
                  "const": "verified"
                },
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
